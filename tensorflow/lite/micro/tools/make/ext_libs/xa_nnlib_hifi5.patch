+/* Odd out_channels: tap t starts at nibble t*oc, so odd taps start on a high nibble.
+ * Loads 16 weights starting at the high nibble of byte 0, same output layout as dw4_load_unpack. */
+static inline void __attribute__((always_inline)) dw4_load_unpack_p1
+  (ae_int8x8 *k_lo
+  ,ae_int8x8 *k_hi
+  ,const WORD8 *pk
+  ,WORD32 nbytes
+  )
+{
+  const ae_int8x16 *q = (const ae_int8x16 *)pk;
+  ae_valignx2 va = AE_LA128_PP(q);
+  ae_int8x8 w0, w1;
+  AE_LAV8X8X2_XP(w0, w1, va, q, nbytes);
+  /* bytes 1..8 of the loaded stream */
+  const ae_int8x8 shift1 = AE_MOVINT8X8_FROMINT32X2(AE_MOVDA32X2((WORD32)0x06050403, (WORD32)0x0201000F));
+  const ae_int64 w_s64 = AE_MOVINT64_FROMINT8X8(AE_SEL8X8(w1, w0, shift1));
+  const ae_int64 mask = AE_MOVINT64_FROMINT32X2(AE_MOVDA32X2((WORD32)0xF0F0F0F0, (WORD32)0xF0F0F0F0));
+  ae_int8x8 d_even = AE_MOVINT8X8_FROMINT64(AE_AND64(AE_MOVINT64_FROMINT8X8(w0), mask));
+  ae_int8x8 d_odd = AE_MOVINT8X8_FROMINT64(AE_AND64(AE_SLLI64(w_s64, 4), mask));
+  const ae_int8x8 sel = AE_MOVINT8X8_FROMINT32X2(AE_MOVDA32X2((WORD32)0xFB73EA62, (WORD32)0xD951C840));
+  AE_DSEL8X8(*k_lo, *k_hi, d_even, d_odd, sel);
+}
+
+/* rem_ch is out_channels - itr_ch, used only for tail tiles */
+static inline void __attribute__((always_inline)) dw4_load_unpack_ph
+  (ae_int8x8 *k_lo
+  ,ae_int8x8 *k_hi
+  ,const WORD8 *pk
+  ,const int phase
+  ,WORD32 rem_ch
+  ,const int is_tail
+  )
+{
+  if(phase)
+    dw4_load_unpack_p1(k_lo, k_hi, pk, is_tail ? ((rem_ch + 2) >> 1) : 9);
+  else
+    dw4_load_unpack(k_lo, k_hi, pk, (rem_ch + 1) >> 1, is_tail);
+}
+
+/* 3 taps whose first tap has nibble phase p0. h = out_channels >> 1. pk is advanced to the next group,
+ * whose first tap has phase p0 ^ 1. */
+static inline void __attribute__((always_inline)) dw4_group3_odd
+  (ae_int32x2 *acc
+  ,ae_int8x16 **pp_inp0
+  ,ae_int8x16 **pp_inp1
+  ,const WORD8 **ppk
+  ,WORD32 h
+  ,WORD32 inp_channels_pad
+  ,WORD32 rem_ch
+  ,const int p0
+  ,const int is_tail
+  )
+{
+  ae_int8x16 *pt_inp0 = *pp_inp0;
+  ae_int8x16 *pt_inp1 = *pp_inp1;
+  const WORD8 *pk = *ppk;
+  ae_int8x8 d_inp000, d_inp001, d_inp010, d_inp011, d_inp020, d_inp021;
+  ae_int8x8 d_inp100, d_inp101, d_inp110, d_inp111, d_inp120, d_inp121;
+  ae_int8x8 d_ker00, d_ker01, d_ker10, d_ker11, d_ker20, d_ker21;
+
+  AE_L8X8X2_XC(d_inp000, d_inp001, pt_inp0, inp_channels_pad);
+  AE_L8X8X2_XC(d_inp010, d_inp011, pt_inp0, inp_channels_pad);
+  AE_L8X8X2_XC(d_inp020, d_inp021, pt_inp0, inp_channels_pad);
+  AE_L8X8X2_XC(d_inp100, d_inp101, pt_inp1, inp_channels_pad);
+  AE_L8X8X2_XC(d_inp110, d_inp111, pt_inp1, inp_channels_pad);
+  AE_L8X8X2_XC(d_inp120, d_inp121, pt_inp1, inp_channels_pad);
+  dw4_load_unpack_ph(&d_ker00, &d_ker01, pk, p0, rem_ch, is_tail);
+  dw4_load_unpack_ph(&d_ker10, &d_ker11, pk + h + p0, p0 ^ 1, rem_ch, is_tail);
+  dw4_load_unpack_ph(&d_ker20, &d_ker21, pk + 2 * h + 1, p0, rem_ch, is_tail);
+
+  AE_MULAZB3X3O8X8(acc[0], acc[1], acc[2], acc[3], d_ker00, d_ker10, d_ker20, d_inp000, d_inp010, d_inp020);
+  AE_MULAZB3X3O8X8(acc[4], acc[5], acc[6], acc[7], d_ker01, d_ker11, d_ker21, d_inp001, d_inp011, d_inp021);
+  AE_MULAZB3X3O8X8(acc[8], acc[9], acc[10], acc[11], d_ker00, d_ker10, d_ker20, d_inp100, d_inp110, d_inp120);
+  AE_MULAZB3X3O8X8(acc[12], acc[13], acc[14], acc[15], d_ker01, d_ker11, d_ker21, d_inp101, d_inp111, d_inp121);
+
+  *pp_inp0 = pt_inp0;
+  *pp_inp1 = pt_inp1;
+  *ppk = pk + 3 * h + 1 + p0;
+}
+
+/* Odd out_channels variant of dw4_acc_taps. pk points at the byte holding tap 0 of this tile. */
+static inline void __attribute__((always_inline)) dw4_acc_taps_odd
+  (ae_int32x2 *acc
+  ,ae_int8x16 *pt_inp0
+  ,ae_int8x16 *pt_inp1
+  ,const WORD8 *pk
+  ,WORD32 h
+  ,WORD32 inp_channels_pad
+  ,WORD32 num_taps
+  ,WORD32 rem_ch
+  ,const int is_tail
+  )
+{
+  WORD32 itr_kw;
+  ae_int8x8 d_inp000, d_inp001, d_inp100, d_inp101;
+  ae_int8x8 d_ker00, d_ker01;
+  const ae_int8x8 zero8x8 = AE_MOVINT8X8_FROMINT16X4(AE_ZERO16());
+
+  WORD32 groups = num_taps / 3;
+#pragma no_unroll
+  for(itr_kw = 0; itr_kw < (groups >> 1); itr_kw++)
+  {
+    dw4_group3_odd(acc, &pt_inp0, &pt_inp1, &pk, h, inp_channels_pad, rem_ch, 0, is_tail);
+    dw4_group3_odd(acc, &pt_inp0, &pt_inp1, &pk, h, inp_channels_pad, rem_ch, 1, is_tail);
+  }
+  if(groups & 1)
+    dw4_group3_odd(acc, &pt_inp0, &pt_inp1, &pk, h, inp_channels_pad, rem_ch, 0, is_tail);
+
+  WORD32 phase = groups & 1;
+  for(itr_kw = groups * 3; itr_kw < num_taps; itr_kw++)
+  {
+    AE_L8X8X2_XC(d_inp000, d_inp001, pt_inp0, inp_channels_pad);
+    AE_L8X8X2_XC(d_inp100, d_inp101, pt_inp1, inp_channels_pad);
+    dw4_load_unpack_ph(&d_ker00, &d_ker01, pk, phase, rem_ch, is_tail);
+    pk += h + phase;
+    phase ^= 1;
+
+    AE_MULAZB3X3O8X8(acc[0], acc[1], acc[2], acc[3], d_ker00, zero8x8, zero8x8, d_inp000, d_inp000, d_inp000);
+    AE_MULAZB3X3O8X8(acc[4], acc[5], acc[6], acc[7], d_ker01, zero8x8, zero8x8, d_inp001, d_inp001, d_inp001);
+    AE_MULAZB3X3O8X8(acc[8], acc[9], acc[10], acc[11], d_ker00, zero8x8, zero8x8, d_inp100, d_inp100, d_inp100);
+    AE_MULAZB3X3O8X8(acc[12], acc[13], acc[14], acc[15], d_ker01, zero8x8, zero8x8, d_inp101, d_inp101, d_inp101);
+  }
+}
+
+/* p_ker is packed int4 [kh][kw][out_channels] */
+static inline void __attribute__((always_inline)) conv2d_v2_nhwc_per_chan_sym4sxasym8s
+  (pWORD8 __restrict__ p_out
+  ,const WORD8 *__restrict__ p_ker
+  ,const WORD8 *__restrict__ p_inp
+  ,const WORD32 *p_bias
+  ,int kernel_height
+  ,int kernel_width
+  ,int out_height
+  ,int out_width
+  ,int out_channels
+  ,int y_stride
+  ,WORD32  input_zero_bias
+  ,const WORD32 *p_out_multiplier
+  ,const WORD32 *p_out_shift
+  ,WORD32  out_zero_bias
+  ,WORD32  out_activation_min
+  ,WORD32  out_activation_max
+  )
+{
+  WORD32 inp_channels_pad, ker_row_bytes;
+  WORD32 itr_oh, itr_ch;
+  ae_int8x16 * __restrict__ pt_inp0;
+  ae_int8x16 * __restrict__ pt_inp1;
+  pUWORD8 out_ptr0, out_ptr1;
+  ae_int8x16 * __restrict__ ae_out_ptr0;
+  ae_int8x16 * __restrict__ ae_out_ptr1;
+  ae_valignx2 out0_a, out1_a;
+  const ae_int32x4 *pt_bias;
+  ae_valignx2 bias_a;
+  ae_int32x2 d_acc0, d_acc1, d_acc2, d_acc3;
+  ae_int32x2 d_acc4, d_acc5, d_acc6, d_acc7;
+  ae_int32x2 d_acc8, d_acc9, d_acc10, d_acc11;
+  ae_int32x2 d_acc12, d_acc13, d_acc14, d_acc15;
+  ae_int32x2 d_bias0, d_bias1, d_bias2, d_bias3;
+  ae_int32x2 d_bias4, d_bias5, d_bias6, d_bias7;
+  ae_int8x8 d_acc8x8_0, d_acc8x8_1;
+
+  inp_channels_pad = (out_channels + 15)&(~15);
+  ker_row_bytes = out_channels >> 1;
+  const WORD32 num_taps = kernel_height * kernel_width;
+
+  ae_int64 biasvc1 = AE_MOVINT64_FROMINT32X2(AE_MOVDA32X2(-input_zero_bias, 0));
+  AE_MOVZBVCDR(biasvc1);
+
+  if(kernel_height == 3 && kernel_width == 3)
+  {
+    dw4_conv2d_3x3(p_out, p_ker, p_inp, p_bias, out_height, out_width, out_channels, y_stride
+                  ,p_out_multiplier, p_out_shift, out_zero_bias, out_activation_min, out_activation_max);
+    return;
+  }
+
+#pragma loop_count min=1
+  for(itr_oh = 0; itr_oh < (out_height); itr_oh += 2)
+  {
+    out_ptr0 = (UWORD8 *)(&p_out[itr_oh * out_channels * out_width]);
+    out_ptr1 = (UWORD8 *)(&p_out[(itr_oh + 1) * out_channels * out_width]);
+    ae_out_ptr0 = (ae_int8x16 *)(out_ptr0);
+    ae_out_ptr1 = (ae_int8x16 *)(out_ptr1);
+    out0_a = AE_ZALIGN128();
+    out1_a = AE_ZALIGN128();
+    pt_bias = (const ae_int32x4 *)p_bias;
+    bias_a = AE_LA128_PP(pt_bias);
+    int ysXkwXic = y_stride * kernel_width * inp_channels_pad;
+
+#pragma loop_count min=1
+    for(itr_ch = 0; itr_ch < out_channels; itr_ch += 16)
+    {
+      ae_int16x4 *pt16x4_inp0 = (ae_int16x4 *)p_inp;
+      AE_ADDCIRC16X4_XC(pt16x4_inp0, itr_ch + itr_oh * ysXkwXic);
+      pt_inp0 = (ae_int8x16 *)pt16x4_inp0;
+      ae_int16x4 *pt16x4_inp1 = (ae_int16x4 *)p_inp;
+      AE_ADDCIRC16X4_XC(pt16x4_inp1, itr_ch + (itr_oh + 1) * ysXkwXic);
+      pt_inp1 = (ae_int8x16 *)pt16x4_inp1;
+      const WORD8 *pt_ker = &p_ker[itr_ch >> 1];
+
+      AE_LA32X2X2_IP(d_bias0, d_bias1, bias_a, pt_bias);
+      AE_LA32X2X2_IP(d_bias2, d_bias3, bias_a, pt_bias);
+      AE_LA32X2X2_IP(d_bias4, d_bias5, bias_a, pt_bias);
+      AE_LA32X2X2_IP(d_bias6, d_bias7, bias_a, pt_bias);
+
+      ae_int32x2 acc[16];
+      WORD32 i;
+      for(i = 0; i < 16; i++)
+        acc[i] = AE_ZERO32();
+
+      if(out_channels & 1)
+      {
+        if(out_channels - itr_ch >= 16)
+          dw4_acc_taps_odd(acc, pt_inp0, pt_inp1, pt_ker, ker_row_bytes, inp_channels_pad, num_taps, out_channels - itr_ch, 0);
+        else
+          dw4_acc_taps_odd(acc, pt_inp0, pt_inp1, pt_ker, ker_row_bytes, inp_channels_pad, num_taps, out_channels - itr_ch, 1);
+      }
+      else if(out_channels - itr_ch >= 16)
+        dw4_acc_taps(acc, pt_inp0, pt_inp1, pt_ker, ker_row_bytes, inp_channels_pad, num_taps, 0, 0);
+      else
+        dw4_acc_taps(acc, pt_inp0, pt_inp1, pt_ker, ker_row_bytes, inp_channels_pad, num_taps, (out_channels - itr_ch) >> 1, 1);
+
+      d_acc0  = SW_ADD32S_INT32X2_INT32X2(AE_SRAI32(acc[0], 4), d_bias0);
+      d_acc1  = SW_ADD32S_INT32X2_INT32X2(AE_SRAI32(acc[1], 4), d_bias1);
+      d_acc2  = SW_ADD32S_INT32X2_INT32X2(AE_SRAI32(acc[2], 4), d_bias2);
+      d_acc3  = SW_ADD32S_INT32X2_INT32X2(AE_SRAI32(acc[3], 4), d_bias3);
+      d_acc4  = SW_ADD32S_INT32X2_INT32X2(AE_SRAI32(acc[4], 4), d_bias4);
+      d_acc5  = SW_ADD32S_INT32X2_INT32X2(AE_SRAI32(acc[5], 4), d_bias5);
+      d_acc6  = SW_ADD32S_INT32X2_INT32X2(AE_SRAI32(acc[6], 4), d_bias6);
+      d_acc7  = SW_ADD32S_INT32X2_INT32X2(AE_SRAI32(acc[7], 4), d_bias7);
+      d_acc8  = SW_ADD32S_INT32X2_INT32X2(AE_SRAI32(acc[8], 4), d_bias0);
+      d_acc9  = SW_ADD32S_INT32X2_INT32X2(AE_SRAI32(acc[9], 4), d_bias1);
+      d_acc10 = SW_ADD32S_INT32X2_INT32X2(AE_SRAI32(acc[10], 4), d_bias2);
+      d_acc11 = SW_ADD32S_INT32X2_INT32X2(AE_SRAI32(acc[11], 4), d_bias3);
+      d_acc12 = SW_ADD32S_INT32X2_INT32X2(AE_SRAI32(acc[12], 4), d_bias4);
+      d_acc13 = SW_ADD32S_INT32X2_INT32X2(AE_SRAI32(acc[13], 4), d_bias5);
+      d_acc14 = SW_ADD32S_INT32X2_INT32X2(AE_SRAI32(acc[14], 4), d_bias6);
+      d_acc15 = SW_ADD32S_INT32X2_INT32X2(AE_SRAI32(acc[15], 4), d_bias7);
+
+      ae_int32x2 d_hh, d_ll;
+      d_hh = AE_SEL32_HH(d_acc0, d_acc8);
+      d_ll = AE_SEL32_LL(d_acc0, d_acc8);
+      d_acc0 = d_hh;
+      d_acc8 = d_ll;
+      d_hh = AE_SEL32_HH(d_acc1, d_acc9);
+      d_ll = AE_SEL32_LL(d_acc1, d_acc9);
+      d_acc1 = d_hh;
+      d_acc9 = d_ll;
+      d_hh = AE_SEL32_HH(d_acc2, d_acc10);
+      d_ll = AE_SEL32_LL(d_acc2, d_acc10);
+      d_acc2 = d_hh;
+      d_acc10 = d_ll;
+      d_hh = AE_SEL32_HH(d_acc3, d_acc11);
+      d_ll = AE_SEL32_LL(d_acc3, d_acc11);
+      d_acc3 = d_hh;
+      d_acc11 = d_ll;
+      d_hh = AE_SEL32_HH(d_acc4, d_acc12);
+      d_ll = AE_SEL32_LL(d_acc4, d_acc12);
+      d_acc4 = d_hh;
+      d_acc12 = d_ll;
+      d_hh = AE_SEL32_HH(d_acc5, d_acc13);
+      d_ll = AE_SEL32_LL(d_acc5, d_acc13);
+      d_acc5 = d_hh;
+      d_acc13 = d_ll;
+      d_hh = AE_SEL32_HH(d_acc6, d_acc14);
+      d_ll = AE_SEL32_LL(d_acc6, d_acc14);
+      d_acc6 = d_hh;
+      d_acc14 = d_ll;
+      d_hh = AE_SEL32_HH(d_acc7, d_acc15);
+      d_ll = AE_SEL32_LL(d_acc7, d_acc15);
+      d_acc7 = d_hh;
+      d_acc15 = d_ll;
+
+      ae_int16x4 d_acc16_0, d_acc16_1, d_acc16_2, d_acc16_3;
+      ae_int16x4 d_acc16_4, d_acc16_5, d_acc16_6, d_acc16_7;
+      ae_int16x4 d_acc16_8, d_acc16_9, d_acc16_10, d_acc16_11;
+      ae_int16x4 d_acc16_12, d_acc16_13, d_acc16_14, d_acc16_15;
+      MPY_BY_QUANT_MULT_X2_OUT16_NO_LR_SHIFT(d_acc16_0, d_acc0, p_out_multiplier[itr_ch + 0], p_out_shift[itr_ch + 0]);
+      MPY_BY_QUANT_MULT_X2_OUT16_NO_LR_SHIFT(d_acc16_8, d_acc8, p_out_multiplier[itr_ch + 1], p_out_shift[itr_ch + 1]);
+      MPY_BY_QUANT_MULT_X2_OUT16_NO_LR_SHIFT(d_acc16_1, d_acc1, p_out_multiplier[itr_ch + 2], p_out_shift[itr_ch + 2]);
+      MPY_BY_QUANT_MULT_X2_OUT16_NO_LR_SHIFT(d_acc16_9, d_acc9, p_out_multiplier[itr_ch + 3], p_out_shift[itr_ch + 3]);
+      MPY_BY_QUANT_MULT_X2_OUT16_NO_LR_SHIFT(d_acc16_2, d_acc2, p_out_multiplier[itr_ch + 4], p_out_shift[itr_ch + 4]);
+      MPY_BY_QUANT_MULT_X2_OUT16_NO_LR_SHIFT(d_acc16_10, d_acc10, p_out_multiplier[itr_ch + 5], p_out_shift[itr_ch + 5]);
+      MPY_BY_QUANT_MULT_X2_OUT16_NO_LR_SHIFT(d_acc16_3, d_acc3, p_out_multiplier[itr_ch + 6], p_out_shift[itr_ch + 6]);
+      MPY_BY_QUANT_MULT_X2_OUT16_NO_LR_SHIFT(d_acc16_11, d_acc11, p_out_multiplier[itr_ch + 7], p_out_shift[itr_ch + 7]);
