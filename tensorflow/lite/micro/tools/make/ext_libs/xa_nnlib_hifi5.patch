+/* Expands 8 int4 weights starting at nibble 'phase' of pk into int8x8 holding weight*16,
+ * channel 0 in the MSB lane like AE_L8X8. The x16 scale is removed from the accumulators. */
+static inline void __attribute__((always_inline)) dw4_unpack8
+  (ae_int8x8 *k
+  ,const WORD8 *pk
+  ,WORD32 nbytes
+  ,const int phase
+  )
+{
+  const ae_int8x16 *q = (const ae_int8x16 *)pk;
+  ae_valignx2 va = AE_LA128_PP(q);
+  ae_int8x8 w0, w1, k_hi;
+  ae_int8x8 d_even, d_odd;
+  AE_LAV8X8X2_XP(w0, w1, va, q, nbytes);
+  const ae_int64 mask = AE_MOVINT64_FROMINT32X2(AE_MOVDA32X2((WORD32)0xF0F0F0F0, (WORD32)0xF0F0F0F0));
+  if(phase)
+  {
+    /* bytes 1..8 of the loaded stream */
+    const ae_int8x8 shift1 = AE_MOVINT8X8_FROMINT32X2(AE_MOVDA32X2((WORD32)0x06050403, (WORD32)0x0201000F));
+    const ae_int64 w_s64 = AE_MOVINT64_FROMINT8X8(AE_SEL8X8(w1, w0, shift1));
+    d_even = AE_MOVINT8X8_FROMINT64(AE_AND64(AE_MOVINT64_FROMINT8X8(w0), mask));
+    d_odd = AE_MOVINT8X8_FROMINT64(AE_AND64(AE_SLLI64(w_s64, 4), mask));
+  }
+  else
+  {
+    const ae_int64 w64 = AE_MOVINT64_FROMINT8X8(w0);
+    d_odd = AE_MOVINT8X8_FROMINT64(AE_AND64(w64, mask));
+    d_even = AE_MOVINT8X8_FROMINT64(AE_AND64(AE_SLLI64(w64, 4), mask));
+    (VOID) w1;
+  }
+  const ae_int8x8 sel = AE_MOVINT8X8_FROMINT32X2(AE_MOVDA32X2((WORD32)0xFB73EA62, (WORD32)0xD951C840));
+  AE_DSEL8X8(*k, k_hi, d_even, d_odd, sel);
+  (VOID) k_hi;
+}
+
+#ifdef AE_MULZB3X3O8X8
+
+/* Unpacks 8 channels of the weights at nibble index nib of the packed kernel */
+static inline void __attribute__((always_inline)) dw4_unpack_tap
+  (ae_int8x8 *k
+  ,const WORD8 *p_ker
+  ,WORD32 nib
+  ,WORD32 rem_ch
+  )
+{
+  const WORD32 phase = nib & 1;
+  dw4_unpack8(k, p_ker + (nib >> 1), (rem_ch + phase + 1) >> 1, phase);
+}
+
+/* 3x3 kernel: one output row x 8 channels per iteration, all 9 taps held in registers */
+static inline void __attribute__((always_inline)) dw4_conv2d_3x3
+  (pWORD8 __restrict__ p_out
+  ,const WORD8 *__restrict__ p_ker
+  ,const WORD8 *__restrict__ p_inp
+  ,const WORD32 *p_bias
+  ,int out_height
+  ,int out_width
+  ,int out_channels
+  ,int y_stride
+  ,const WORD32 *p_out_multiplier
+  ,const WORD32 *p_out_shift
+  ,WORD32  out_zero_bias
+  ,WORD32  out_activation_min
+  ,WORD32  out_activation_max
+  )
+{
+  WORD32 itr_oh, itr_ch;
+  const WORD32 inp_channels_pad = (out_channels + 15)&(~15);
+  const WORD32 ysXkwXic = y_stride * 3 * inp_channels_pad;
+  pUWORD8 out_ptr0;
+  ae_int8x16 * __restrict__ ae_out_ptr0;
+  ae_valignx2 out0_a;
+  const ae_int32x4 *pt_bias;
+  const ae_int32x4 *pt_outm;
+  const ae_int32x4 *pt_outs;
+  ae_valignx2 bias_a;
+  ae_int32x2 outmult01, outmult23, outmult45, outmult67;
+  ae_int32x2 lmult01, lmult23, lmult45, lmult67;
+  ae_int32x2 rmult01, rmult23, rmult45, rmult67;
+  ae_int32x2 d_acc0, d_acc1, d_acc2, d_acc3;
+  ae_int32x2 d_bias0, d_bias1, d_bias2, d_bias3;
+  ae_int8x8 d_acc8x8_0;
+
+  pt_bias = (const ae_int32x4 *)p_bias;
+  bias_a = AE_LA128_PP(pt_bias);
+  for(itr_ch = 0; itr_ch < out_channels; itr_ch += 8)
+  {
+    const WORD32 rem_ch = XT_MIN(out_channels - itr_ch, 8);
+    ae_int8x8 d_inp000, d_inp010, d_inp020;
+    ae_int8x8 d_ker00, d_ker10, d_ker20;
+    ae_int8x8 d_ker30, d_ker40, d_ker50;
+    ae_int8x8 d_ker60, d_ker70, d_ker80;
+
+    AE_LA32X2X2_IP(d_bias0, d_bias1, bias_a, pt_bias);
+    AE_LA32X2X2_IP(d_bias2, d_bias3, bias_a, pt_bias);
+    ae_int16x4 *pt16x4_inp0 = (ae_int16x4 *)p_inp;
+    AE_ADDCIRC16X4_XC(pt16x4_inp0, itr_ch);
+    ae_int8x8 * __restrict__ pt_inp0 = (ae_int8x8 *)pt16x4_inp0;
+
+    dw4_unpack_tap(&d_ker00, p_ker, 0 * out_channels + itr_ch, rem_ch);
+    dw4_unpack_tap(&d_ker10, p_ker, 1 * out_channels + itr_ch, rem_ch);
+    dw4_unpack_tap(&d_ker20, p_ker, 2 * out_channels + itr_ch, rem_ch);
+    dw4_unpack_tap(&d_ker30, p_ker, 3 * out_channels + itr_ch, rem_ch);
+    dw4_unpack_tap(&d_ker40, p_ker, 4 * out_channels + itr_ch, rem_ch);
+    dw4_unpack_tap(&d_ker50, p_ker, 5 * out_channels + itr_ch, rem_ch);
+    dw4_unpack_tap(&d_ker60, p_ker, 6 * out_channels + itr_ch, rem_ch);
+    dw4_unpack_tap(&d_ker70, p_ker, 7 * out_channels + itr_ch, rem_ch);
+    dw4_unpack_tap(&d_ker80, p_ker, 8 * out_channels + itr_ch, rem_ch);
+
+#if TFLITE_SINGLE_ROUNDING
+    pt_outs = (const ae_int32x4 *)(&p_out_shift[itr_ch]);
+    pt_outm = (const ae_int32x4 *)(&p_out_multiplier[itr_ch]);
+    ae_valignx2 outs_a, outm_a;
+    outs_a = AE_LA128_PP(pt_outs);
+    outm_a = AE_LA128_PP(pt_outm);
+
+    AE_LA32X2X2_IP(lmult01, lmult23, outs_a, pt_outs);
+    AE_LA32X2X2_IP(lmult45, lmult67, outs_a, pt_outs);
+    AE_LA32X2X2_IP(outmult01, outmult23, outm_a, pt_outm);
+    AE_LA32X2X2_IP(outmult45, outmult67, outm_a, pt_outm);
+
+#ifdef AE_TRUNCAV32X2F64S
+    ae_int16x4 ls0123 = AE_ADD16(AE_SAT16X4(lmult01, lmult23), AE_MOVDA16(17));
+    ae_int16x4 ls4567 = AE_ADD16(AE_SAT16X4(lmult45, lmult67), AE_MOVDA16(17));
+    lmult01 = AE_MOVINT32X2_FROMINT16X4(ls0123);
+    lmult45 = AE_MOVINT32X2_FROMINT16X4(ls4567);
+#endif
+
+    (void)rmult01;
+    (void)rmult23;
+    (void)rmult45;
+    (void)rmult67;
+#else /* #if TFLITE_SINGLE_ROUNDING */
+    int p_left_shift[8] __attribute__ ((aligned (16)));
+    int p_right_shift[8] __attribute__ ((aligned (16)));
+    ae_int32x2 ONE = SW_MOVDA32(1);
+    ae_int32x2 M_ONE = SW_MOVDA32(0xFFFFFFFF);
+    pt_outs = (const ae_int32x4 *)(&p_out_shift[itr_ch]);
+    ae_int32x4 * __restrict__ p_lmult = (ae_int32x4 *)(&p_left_shift[0]);
+    ae_int32x4 * __restrict__ p_rmult = (ae_int32x4 *)(&p_right_shift[0]);
+    ae_valignx2 outs_a;
+    outs_a = AE_LA128_PP(pt_outs);
+
+    int i;
+    for(i = 0; i < 2; i++)
+    {
+      ae_int32x2 d_shift0, d_shift1;
+      ae_int32x2 d_lsh0, d_lsh1;
+      ae_int32x2 d_rsh0, d_rsh1;
+      ae_int32x2 temp0, temp1, temp2, temp3;
+      AE_LA32X2X2_IP(d_shift0, d_shift1, outs_a, pt_outs);
+      /* Invert sign for AE_SRAV32RS */
+      AE_MUL2P32X4S(d_shift0, d_shift1, d_shift0, d_shift1, M_ONE, M_ONE);
+      d_lsh0 = AE_MIN32(AE_ZERO32(), d_shift0);
+      d_lsh1 = AE_MIN32(AE_ZERO32(), d_shift1);
+      d_rsh0 = AE_MAX32(AE_ZERO32(), d_shift0);
+      d_rsh1 = AE_MAX32(AE_ZERO32(), d_shift1);
+      temp0 = AE_SRAV32RS(ONE, d_lsh0);
+      temp1 = AE_SRAV32RS(ONE, d_lsh1);
+      AE_S32X2X2_IP(temp0, temp1, p_lmult, 16);
+      temp2 = AE_SRAV32RS(M_ONE, AE_NEG32((AE_SUB32(SW_MOVDA32(31), d_rsh0))));
+      temp3 = AE_SRAV32RS(M_ONE, AE_NEG32((AE_SUB32(SW_MOVDA32(31), d_rsh1))));
+      AE_S32X2X2_IP(temp2, temp3, p_rmult, 16);
+    }
+
+    pt_outm = (const ae_int32x4 *)(&p_out_multiplier[itr_ch]);
+    ae_valignx2 outm_a = AE_LA128_PP(pt_outm);
+    AE_LA32X2X2_IP(outmult01, outmult23, outm_a, pt_outm);
+    AE_LA32X2X2_IP(outmult45, outmult67, outm_a, pt_outm);
+#endif /* #if TFLITE_SINGLE_ROUNDING */
+
+#pragma loop_count min=1
+    for(itr_oh = 0; itr_oh < out_height; itr_oh++)
+    {
+      out_ptr0 = (UWORD8 *)(&p_out[itr_ch + itr_oh * out_channels * out_width]);
+      ae_out_ptr0 = (ae_int8x16 *)(out_ptr0);
+      out0_a = AE_ZALIGN128();
+
+      AE_L8X8_XC(d_inp000, pt_inp0, inp_channels_pad);
+      AE_L8X8_XC(d_inp010, pt_inp0, inp_channels_pad);
+      AE_L8X8_XC(d_inp020, pt_inp0, inp_channels_pad);
+      AE_MULZB3X3O8X8(d_acc0, d_acc1, d_acc2, d_acc3, d_ker00, d_ker10, d_ker20, d_inp000, d_inp010, d_inp020);
+
+      AE_L8X8_XC(d_inp000, pt_inp0, inp_channels_pad);
+      AE_L8X8_XC(d_inp010, pt_inp0, inp_channels_pad);
+      AE_L8X8_XC(d_inp020, pt_inp0, inp_channels_pad);
+      AE_MULAZB3X3O8X8(d_acc0, d_acc1, d_acc2, d_acc3, d_ker30, d_ker40, d_ker50, d_inp000, d_inp010, d_inp020);
+
+      AE_L8X8_XC(d_inp000, pt_inp0, inp_channels_pad);
+      AE_L8X8_XC(d_inp010, pt_inp0, inp_channels_pad);
+      AE_L8X8_XC(d_inp020, pt_inp0, ysXkwXic - 8*inp_channels_pad);
+      AE_MULAZB3X3O8X8(d_acc0, d_acc1, d_acc2, d_acc3, d_ker60, d_ker70, d_ker80, d_inp000, d_inp010, d_inp020);
+
+      d_acc0 = SW_ADD32S_INT32X2_INT32X2(AE_SRAI32(d_acc0, 4), d_bias0);
+      d_acc1 = SW_ADD32S_INT32X2_INT32X2(AE_SRAI32(d_acc1, 4), d_bias1);
+      d_acc2 = SW_ADD32S_INT32X2_INT32X2(AE_SRAI32(d_acc2, 4), d_bias2);
+      d_acc3 = SW_ADD32S_INT32X2_INT32X2(AE_SRAI32(d_acc3, 4), d_bias3);
+
+#if !TFLITE_SINGLE_ROUNDING
+      p_lmult = (ae_int32x4 *)(&p_left_shift[0]);
+      p_rmult = (ae_int32x4 *)(&p_right_shift[0]);
+#endif
+
+      ae_int16x4 out0, out1;
+#if !TFLITE_SINGLE_ROUNDING
+      AE_L32X2X2_I(lmult01, lmult23, p_lmult, 0);
+      AE_L32X2X2_I(rmult01, rmult23, p_rmult, 0);
+#endif
+      MPY_BY_QUANT_MULT_PER_CHAN_LR_MULT_X2X2_OUT16_ZB_AV(out0, d_acc0, d_acc1, outmult01, outmult23, lmult01, lmult23, rmult01, rmult23, out_zero_bias);
+
+#if !TFLITE_SINGLE_ROUNDING
+      AE_L32X2X2_I(lmult45, lmult67, p_lmult, 16);
+      AE_L32X2X2_I(rmult45, rmult67, p_rmult, 16);
+#endif
+
+      MPY_BY_QUANT_MULT_PER_CHAN_LR_MULT_X2X2_OUT16_ZB_AV(out1, d_acc2, d_acc3, outmult45, outmult67, lmult45, lmult67, rmult45, rmult67, out_zero_bias);
+
+      d_acc8x8_0 = AE_SAT8X8X16(out0, out1);
+      d_acc8x8_0 = AE_MAX8(d_acc8x8_0, AE_MOVDA8(out_activation_min));
+      d_acc8x8_0 = AE_MIN8(d_acc8x8_0, AE_MOVDA8(out_activation_max));
+
+      AE_SAV8X8X2_XP(d_acc8x8_0, d_acc8x8_0, out0_a, ae_out_ptr0, rem_ch);
+      AE_SA128POS_FP(out0_a, ae_out_ptr0);
+    }
+  }
+}
+
+/* Loads 16 packed int4 weights (8 bytes) and expands them to two int8x8 vectors
+ * holding weight*16 in channel order. The x16 scale is removed from the
+ * accumulators after the tap loop. */
+static inline void __attribute__((always_inline)) dw4_load_unpack
+  (ae_int8x8 *k_lo
+  ,ae_int8x8 *k_hi
+  ,const WORD8 *pk
+  ,WORD32 tail_bytes
+  ,const int is_tail
+  )
+{
+  ae_int8x8 w;
+  if(is_tail)
+  {
+    const ae_int8x16 *q = (const ae_int8x16 *)pk;
+    ae_valignx2 va = AE_LA128_PP(q);
+    ae_int8x8 w_unused;
+    AE_LAV8X8X2_XP(w, w_unused, va, q, tail_bytes);
+    (VOID) w_unused;
+  }
+  else
+  {
+    const ae_int8x8 *q = (const ae_int8x8 *)pk;
+    ae_valign va = AE_LA64_PP(q);
+    AE_LA8X8_IP(w, va, q);
+  }
+  const ae_int64 mask = AE_MOVINT64_FROMINT32X2(AE_MOVDA32X2((WORD32)0xF0F0F0F0, (WORD32)0xF0F0F0F0));
+  const ae_int64 w64 = AE_MOVINT64_FROMINT8X8(w);
+  ae_int8x8 d_odd = AE_MOVINT8X8_FROMINT64(AE_AND64(w64, mask));
+  ae_int8x8 d_even = AE_MOVINT8X8_FROMINT64(AE_AND64(AE_SLLI64(w64, 4), mask));
+  const ae_int8x8 sel = AE_MOVINT8X8_FROMINT32X2(AE_MOVDA32X2((WORD32)0xFB73EA62, (WORD32)0xD951C840));
+  AE_DSEL8X8(*k_lo, *k_hi, d_even, d_odd, sel);
+}
+
+/* Accumulates num_taps taps for a 2-row x 16-channel tile into acc[16] */
+static inline void __attribute__((always_inline)) dw4_acc_taps
+  (ae_int32x2 *acc
+  ,ae_int8x16 *pt_inp0
+  ,ae_int8x16 *pt_inp1
+  ,const WORD8 *pk
+  ,WORD32 ker_row_bytes
+  ,WORD32 inp_channels_pad
+  ,WORD32 num_taps
+  ,WORD32 tail_bytes
+  ,const int is_tail
+  )
+{
+  WORD32 itr_kw;
+  ae_int8x8 d_inp000, d_inp001, d_inp010, d_inp011, d_inp020, d_inp021;
+  ae_int8x8 d_inp100, d_inp101, d_inp110, d_inp111, d_inp120, d_inp121;
+  ae_int8x8 d_ker00, d_ker01, d_ker10, d_ker11, d_ker20, d_ker21;
+  const ae_int8x8 zero8x8 = AE_MOVINT8X8_FROMINT16X4(AE_ZERO16());
+
+  WORD32 loop_count = num_taps / 3;
+#pragma no_unroll
+  for(itr_kw = 0; itr_kw < loop_count; itr_kw++)
+  {
+    AE_L8X8X2_XC(d_inp000, d_inp001, pt_inp0, inp_channels_pad);
+    AE_L8X8X2_XC(d_inp010, d_inp011, pt_inp0, inp_channels_pad);
+    AE_L8X8X2_XC(d_inp020, d_inp021, pt_inp0, inp_channels_pad);
+    AE_L8X8X2_XC(d_inp100, d_inp101, pt_inp1, inp_channels_pad);
+    AE_L8X8X2_XC(d_inp110, d_inp111, pt_inp1, inp_channels_pad);
+    AE_L8X8X2_XC(d_inp120, d_inp121, pt_inp1, inp_channels_pad);
+    dw4_load_unpack(&d_ker00, &d_ker01, pk, tail_bytes, is_tail);
+    pk += ker_row_bytes;
+    dw4_load_unpack(&d_ker10, &d_ker11, pk, tail_bytes, is_tail);
+    pk += ker_row_bytes;
+    dw4_load_unpack(&d_ker20, &d_ker21, pk, tail_bytes, is_tail);
+    pk += ker_row_bytes;
+
+    AE_MULAZB3X3O8X8(acc[0], acc[1], acc[2], acc[3], d_ker00, d_ker10, d_ker20, d_inp000, d_inp010, d_inp020);
+    AE_MULAZB3X3O8X8(acc[4], acc[5], acc[6], acc[7], d_ker01, d_ker11, d_ker21, d_inp001, d_inp011, d_inp021);
+    AE_MULAZB3X3O8X8(acc[8], acc[9], acc[10], acc[11], d_ker00, d_ker10, d_ker20, d_inp100, d_inp110, d_inp120);
+    AE_MULAZB3X3O8X8(acc[12], acc[13], acc[14], acc[15], d_ker01, d_ker11, d_ker21, d_inp101, d_inp111, d_inp121);
+  }
+  for(itr_kw = loop_count * 3; itr_kw < num_taps; itr_kw++)
+  {
+    AE_L8X8X2_XC(d_inp000, d_inp001, pt_inp0, inp_channels_pad);
+    AE_L8X8X2_XC(d_inp100, d_inp101, pt_inp1, inp_channels_pad);
+    dw4_load_unpack(&d_ker00, &d_ker01, pk, tail_bytes, is_tail);
+    pk += ker_row_bytes;
+
+    AE_MULAZB3X3O8X8(acc[0], acc[1], acc[2], acc[3], d_ker00, zero8x8, zero8x8, d_inp000, d_inp000, d_inp000);
+    AE_MULAZB3X3O8X8(acc[4], acc[5], acc[6], acc[7], d_ker01, zero8x8, zero8x8, d_inp001, d_inp001, d_inp001);
+    AE_MULAZB3X3O8X8(acc[8], acc[9], acc[10], acc[11], d_ker00, zero8x8, zero8x8, d_inp100, d_inp100, d_inp100);
+    AE_MULAZB3X3O8X8(acc[12], acc[13], acc[14], acc[15], d_ker01, zero8x8, zero8x8, d_inp101, d_inp101, d_inp101);
+  }
+}
