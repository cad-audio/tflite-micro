diff --git a/algo/kernels/basic/hifi5/xa_nn_elm_rsqrt_quant16.c b/algo/kernels/basic/hifi5/xa_nn_elm_rsqrt_quant16.c
new file mode 100644
index 0000000..159652e
--- /dev/null
+++ b/algo/kernels/basic/hifi5/xa_nn_elm_rsqrt_quant16.c
@@ -0,0 +1,220 @@
+#include "xa_nnlib_common.h"
+#include "xa_nn_basic_state.h"
+#include "xa_nnlib_common_macros_hifi5.h"
+#include "xa_nnlib_quant_macros_hifi5.h"
+#include <stdint.h>
+
+static const int32_t Q31_minus_1_16 = 0x7fffffff;
+static const int32_t FIXED_POINT_HALF_THREE_16 = 0x18000000;
+static const int32_t FIXED_POINT_ONE_16 = 0x10000000;
+static const int32_t FIXED_POINT_HALF_SQRT_2_16 = 0x5a82799a;
+
+static inline ae_int32x2 __attribute__((always_inline)) rsqrt_newton_x2(ae_int32x2 fixedpoint_half_input, ae_int32x2 x)
+{
+  ae_int32x2 x2, x3, y1, y2;
+  const ae_int32x2 half_three = SW_MOVDA32(FIXED_POINT_HALF_THREE_16);
+  int i;
+  for(i = 0; i < 5; i++)
+  {
+    x2 = AE_MOVINT32X2_FROMF32X2(AE_MULFP32X2RS(AE_MOVF32X2_FROMINT32X2(x), AE_MOVF32X2_FROMINT32X2(x)));
+    x3 = AE_MOVINT32X2_FROMF32X2(AE_MULFP32X2RS(AE_MOVF32X2_FROMINT32X2(x2), AE_MOVF32X2_FROMINT32X2(x)));
+    x3 = AE_MOVINT32X2_FROMF32X2(AE_SLAI32S(AE_MOVF32X2_FROMINT32X2(x3), 6));
+
+    y1 = AE_MOVINT32X2_FROMF32X2(AE_MULFP32X2RS(AE_MOVF32X2_FROMINT32X2(half_three), AE_MOVF32X2_FROMINT32X2(x)));
+    y2 = AE_MOVINT32X2_FROMF32X2(AE_MULFP32X2RS(AE_MOVF32X2_FROMINT32X2(fixedpoint_half_input), AE_MOVF32X2_FROMINT32X2(x3)));
+
+    x = AE_MOVINT32X2_FROMF32X2(AE_SUB32S(AE_MOVF32X2_FROMINT32X2(y1), AE_MOVF32X2_FROMINT32X2(y2)));
+    x = AE_MOVINT32X2_FROMF32X2(AE_SLAI32S(AE_MOVF32X2_FROMINT32X2(x), 3));
+  }
+  return x;
+}
+
+static inline void __attribute__((always_inline)) get_inv_sqrt_quad(ae_int32x2 *out_mult0_1, ae_int32x2 *out_mult2_3,
+                                      int32_t *out_shift0, int32_t *out_shift1,
+                                      int32_t *out_shift2, int32_t *out_shift3,
+                                      ae_int32x2 inp0_1, ae_int32x2 inp2_3)
+{
+  const ae_int32x2 one = SW_MOVDA32(1);
+  const ae_int32x2 eleven = SW_MOVDA32(11);
+  const ae_int32x2 zero = AE_ZERO32();
+  const ae_int32x2 q31m1 = SW_MOVDA32(Q31_minus_1_16);
+
+  xtbool2 is_edge_01 = AE_LE32(inp0_1, one);
+  xtbool2 is_edge_23 = AE_LE32(inp2_3, one);
+
+  ae_int32x2 v01 = inp0_1;
+  ae_int32x2 v23 = inp2_3;
+  AE_MOVT32X2(v01, SW_MOVDA32(2), is_edge_01); /* dummy safe value; result overridden below */
+  AE_MOVT32X2(v23, SW_MOVDA32(2), is_edge_23);
+
+  /* AE_NSA32X4 computes the per-lane normalization shift amount (== clz-1
+   * for positive values) across both pairs in a single vector instruction. */
+  ae_int16x4 nsa = AE_NSA32X4(v01, v23);
+  ae_f32x2 nsa01_f32, nsa23_f32;
+  AE_CVTA32X4F16S(nsa01_f32, nsa23_f32, nsa, 0);
+  ae_int32x2 nsa01 = AE_MOVINT32X2_FROMF32X2(nsa01_f32);
+  ae_int32x2 nsa23 = AE_MOVINT32X2_FROMF32X2(nsa23_f32);
+
+  ae_int32x2 pairs01 = AE_SUB32(AE_SRAI32(nsa01, 1), one);
+  ae_int32x2 pairs23 = AE_SUB32(AE_SRAI32(nsa23, 1), one);
+  ae_int32x2 shift01 = AE_SUB32(eleven, pairs01);
+  ae_int32x2 shift23 = AE_SUB32(eleven, pairs23);
+
+  ae_int32x2 norm01 = AE_SRAV32RS(v01, AE_NEG32(AE_SLAI32(pairs01, 1)));
+  ae_int32x2 norm23 = AE_SRAV32RS(v23, AE_NEG32(AE_SLAI32(pairs23, 1)));
+
+  ae_int32x2 half_input01 = AE_SRAI32(AE_SRAI32(norm01, 1), 1);
+  ae_int32x2 half_input23 = AE_SRAI32(AE_SRAI32(norm23, 1), 1);
+
+  ae_int32x2 x01 = SW_MOVDA32(FIXED_POINT_ONE_16);
+  ae_int32x2 x23 = SW_MOVDA32(FIXED_POINT_ONE_16);
+  x01 = rsqrt_newton_x2(half_input01, x01);
+  x23 = rsqrt_newton_x2(half_input23, x23);
+
+  ae_int32x2 mult01 = AE_MOVINT32X2_FROMF32X2(AE_MULFP32X2RS(AE_MOVF32X2_FROMINT32X2(x01), AE_MOVF32X2_FROMINT32X2(SW_MOVDA32(FIXED_POINT_HALF_SQRT_2_16))));
+  ae_int32x2 mult23 = AE_MOVINT32X2_FROMF32X2(AE_MULFP32X2RS(AE_MOVF32X2_FROMINT32X2(x23), AE_MOVF32X2_FROMINT32X2(SW_MOVDA32(FIXED_POINT_HALF_SQRT_2_16))));
+
+  /* shift < 0: left-shift mult by -shift and clamp shift to 0 (matches the
+   * scalar reference's `if(output_shift<0){mult<<=-shift; shift=0;}`). */
+  xtbool2 neg01 = AE_LT32(shift01, zero);
+  xtbool2 neg23 = AE_LT32(shift23, zero);
+  ae_int32x2 mult01_shifted = AE_SRAV32RS(mult01, shift01);
+  ae_int32x2 mult23_shifted = AE_SRAV32RS(mult23, shift23);
+  AE_MOVT32X2(mult01, mult01_shifted, neg01);
+  AE_MOVT32X2(mult23, mult23_shifted, neg23);
+  AE_MOVT32X2(shift01, zero, neg01);
+  AE_MOVT32X2(shift23, zero, neg23);
+
+  shift01 = AE_NEG32(shift01); /* reverse_shift == -1 */
+  shift23 = AE_NEG32(shift23);
+
+  AE_MOVT32X2(mult01, q31m1, is_edge_01);
+  AE_MOVT32X2(mult23, q31m1, is_edge_23);
+  AE_MOVT32X2(shift01, zero, is_edge_01);
+  AE_MOVT32X2(shift23, zero, is_edge_23);
+
+  *out_mult0_1 = mult01;
+  *out_mult2_3 = mult23;
+  *out_shift0 = AE_MOVAD32_H(shift01);
+  *out_shift1 = AE_MOVAD32_L(shift01);
+  *out_shift2 = AE_MOVAD32_H(shift23);
+  *out_shift3 = AE_MOVAD32_L(shift23);
+}
+
+
+static inline ae_int32x2 __attribute__((always_inline)) quantize_by_one_pair(ae_int32x2 mult_pair, int32_t shift0, int32_t shift1)
+{
+#if (XCHAL_HAVE_HIFI5S && TFLITE_SINGLE_ROUNDING)
+  int32_t total_shift0 = 31 - shift0;
+  int32_t total_shift1 = 31 - shift1;
+  int32_t packed_shift = (total_shift0 << 16) | (total_shift1 & 0xFFFF);
+  ae_int32x2 out;
+  MPY_BY_QUANT_MULT_X2_OUT32_HIFI5S(out, mult_pair, 1, packed_shift, packed_shift);
+  return out;
+#else
+  ae_int32x2 out0, out1;
+  MPY_BY_QUANT_MULT_X2_OUT32(out0, mult_pair, 1, shift0, shift0);
+  MPY_BY_QUANT_MULT_X2_OUT32(out1, mult_pair, 1, shift1, shift1);
+  return AE_SEL32_HL(out0, out1);
+#endif
+}
+
+/* int16 RSQRT TFLM operator
+ * Only single rounding mode is supported
+ */
+WORD32 xa_nn_elm_rsqrt_sym16s_sym16s(WORD16 * __restrict__ p_out,
+                                const WORD16 * __restrict__ p_inp,
+                                WORD32 multiplier,
+                                WORD32 shift,
+                                WORD32 num_elm)
+{
+  /* NULL pointer checks */
+  XA_NNLIB_ARG_CHK_PTR(p_out, -1);
+  XA_NNLIB_ARG_CHK_PTR(p_inp, -1);
+  /* Pointer alignment checks */
+  XA_NNLIB_ARG_CHK_ALIGN(p_out, sizeof(WORD16), -1);
+  XA_NNLIB_ARG_CHK_ALIGN(p_inp, sizeof(WORD16), -1);
+  /* Basic Parameter checks */
+  XA_NNLIB_ARG_CHK_COND((num_elm <= 0), -1);
+
+  int j;
+  const int full_num_elm = num_elm & ~3;
+  const int32_t kShift = 20;
+  WORD32 out_shift = shift - kShift;
+  WORD32 l_shift;
+  l_shift = out_shift;
+  WORD32 r_shift = 0;
+  (void)r_shift;
+
+  ae_int16x4 a0_3;
+  ae_int32x2 inp0_1, inp2_3;
+  ae_int16x4 out0;
+  const ae_int16x4 max16 = AE_MOVDA16(32767);
+
+  ae_int16x4 * __restrict__ p_a4 = (ae_int16x4 *)p_inp;
+  ae_int16x4 * __restrict__ p_c4 = (ae_int16x4 *)p_out;
+  ae_valign va_a4;
+  ae_valign va_c4;
+  va_a4 = AE_LA64_PP(p_a4);
+  va_c4 = AE_ZALIGN64();
+
+  /* Unroll by 4, as unroll by 8 does not schedule */
+  for(j = 0; j < full_num_elm; j+=4)
+  {
+    AE_LA16X4_IP(a0_3, va_a4, p_a4);
+
+    xtbool4 is_zero0 = AE_EQ16(a0_3, AE_MOVDA16(0));
+
+    ae_f32x2 inp0_1_f, inp2_3_f;
+    AE_CVTA32X4F16S(inp0_1_f, inp2_3_f, a0_3, 0);
+    inp0_1 = AE_MOVINT32X2_FROMF32X2(inp0_1_f);
+    inp2_3 = AE_MOVINT32X2_FROMF32X2(inp2_3_f);
+
+    ae_int32x2 mult0_1, mult2_3;
+    int32_t shift0, shift1, shift2, shift3;
+    get_inv_sqrt_quad(&mult0_1, &mult2_3, &shift0, &shift1, &shift2, &shift3, inp0_1, inp2_3);
+
+    ae_int32x2 data0_1 = quantize_by_one_pair(mult0_1, shift0+kShift, shift1+kShift);
+    ae_int32x2 data2_3 = quantize_by_one_pair(mult2_3, shift2+kShift, shift3+kShift);
+
+    MPY_BY_QUANT_MULT_X2X2_OUT16(out0, data0_1, data2_3, multiplier, l_shift, r_shift);
+
+    AE_MOVT16X4(out0, max16, is_zero0);
+
+    AE_SA16X4_IP(out0, va_c4, p_c4);
+  }
+  AE_SA64POS_FP(va_c4, p_c4);
+
+  int rem_elm = num_elm - full_num_elm;
+  if(rem_elm > 0)
+  {
+    ae_int16x8 *p_a8_tail = (ae_int16x8 *)(p_inp + full_num_elm);
+    ae_valignx2 va_a8_tail = AE_LA128_PP(p_a8_tail);
+    ae_int16x4 a4_7;
+    AE_LAV16X4X2_XP(a0_3, a4_7, va_a8_tail, p_a8_tail, rem_elm * 2);
+
+    xtbool4 is_zero0 = AE_EQ16(a0_3, AE_MOVDA16(0));
+
+    ae_f32x2 inp0_1_f, inp2_3_f;
+    AE_CVTA32X4F16S(inp0_1_f, inp2_3_f, a0_3, 0);
+    inp0_1 = AE_MOVINT32X2_FROMF32X2(inp0_1_f);
+    inp2_3 = AE_MOVINT32X2_FROMF32X2(inp2_3_f);
+
+    ae_int32x2 mult0_1, mult2_3;
+    int32_t shift0, shift1, shift2, shift3;
+    get_inv_sqrt_quad(&mult0_1, &mult2_3, &shift0, &shift1, &shift2, &shift3, inp0_1, inp2_3);
+
+    ae_int32x2 data0_1 = quantize_by_one_pair(mult0_1, shift0 + kShift, shift1 + kShift);
+    ae_int32x2 data2_3 = quantize_by_one_pair(mult2_3, shift2 + kShift, shift3 + kShift);
+
+    MPY_BY_QUANT_MULT_X2X2_OUT16(out0, data0_1, data2_3, multiplier, l_shift, r_shift);
+    AE_MOVT16X4(out0, max16, is_zero0);
+
+    ae_int16x8 *p_c8_tail = (ae_int16x8 *)(p_out + full_num_elm);
+    ae_valignx2 va_c8_tail = AE_ZALIGN128();
+    AE_SAV16X4X2_XP(out0, out0, va_c8_tail, p_c8_tail, rem_elm * 2);
+    AE_SA128POS_FP(va_c8_tail, p_c8_tail);
+  }
+
+  return 0;
+}
