+/* One kernel tap for a 2-row x 8-channel tile */
+static inline void __attribute__((always_inline)) dw4_tap8
+  (ae_int32x2 *acc
+  ,ae_int8x8 **pp_inp
+  ,WORD32 inp_step0
+  ,WORD32 inp_step1
+  ,const WORD8 *pk
+  ,WORD32 nbytes
+  ,const int phase
+  ,ae_int8x8 izb8
+  )
+{
+  ae_int8x8 *pt = *pp_inp;
+  ae_int8x8 d_inp0, d_inp1, d_ker;
+  ae_int16x4 d_inp00, d_inp01, d_inp10, d_inp11;
+  ae_int16x4 d_ker0, d_ker1;
+
+  AE_L8X8_XC(d_inp0, pt, inp_step0);
+  AE_L8X8_XC(d_inp1, pt, inp_step1);
+  *pp_inp = pt;
+  dw4_unpack8(&d_ker, pk, nbytes, phase);
+  AE_SUBW8(d_inp00, d_inp01, d_inp0, izb8);
+  AE_SUBW8(d_inp10, d_inp11, d_inp1, izb8);
+  AE_SUBW8(d_ker0, d_ker1, d_ker, AE_MOVDA8(0));
+  AE_MULA16X4(acc[0], acc[1], d_inp00, d_ker0);
+  AE_MULA16X4(acc[2], acc[3], d_inp01, d_ker1);
+  AE_MULA16X4(acc[4], acc[5], d_inp10, d_ker0);
+  AE_MULA16X4(acc[6], acc[7], d_inp11, d_ker1);
+}
